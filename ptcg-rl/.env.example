# Use absolute paths. Never commit the real .env.
PTCG_OFFICIAL_ARCHIVE=/absolute/path/pokemon-tcg-ai-battle.zip
PTCG_SAMPLE_AGENTS_ARCHIVE=/absolute/path/sample-agents.zip
PTCG_RESEARCH_ARCHIVE=/absolute/path/PTCG.zip
PTCG_ASSET_ROOT=/absolute/path/to/private/assets
PTCG_RUN_ROOT=/absolute/path/to/runs

# Credentials belong in native secret stores, not this file.
# KAGGLE_API_TOKEN=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

ALLOW_PAID_RUNS=0
MAX_RUN_COST_USD=0

