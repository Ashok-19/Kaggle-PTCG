{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ptcg-rl/private-rule-baseline-v1.schema.json",
  "title": "Private rule baseline receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "policy_id", "notebook", "module", "deck"],
  "properties": {
    "schema_version": {"const": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "notebook": {"$ref": "#/$defs/artifact"},
    "module": {"$ref": "#/$defs/artifact"},
    "deck": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
