# Paths only. Use absolute paths. Do not commit the real .env.
PTCG_OFFICIAL_ARCHIVE=/absolute/path/pokemon-tcg-ai-battle.zip
PTCG_SAMPLE_AGENTS_ARCHIVE=/absolute/path/sample-agents.zip
PTCG_RESEARCH_ARCHIVE=/absolute/path/PTCG.zip
PTCG_PRIVATE_ROOT=/absolute/path/to/private
PTCG_ASSET_ROOT=/absolute/path/to/private/assets
PTCG_REPLAY_ROOT=/absolute/path/to/ptcg-replays
PTCG_RUN_ROOT=/absolute/path/to/ptcg-runs

# Cache/storage limits
KAGGLEHUB_CACHE=/absolute/path/to/ptcg-replays/kagglehub-cache
PTCG_MAX_LOCAL_DISK_GB=25
PTCG_MAX_RAW_REPLAY_GB=10
PTCG_MIN_FREE_DISK_GB=8

# Credentials should normally be configured in native secret stores.
# KAGGLE_API_TOKEN=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Paid/external mutations are disabled until explicitly approved.
ALLOW_PAID_RUNS=0
MAX_RUN_COST_USD=1.00
